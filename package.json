{
  "name": "kanban-hexagonal",
  "version": "1.0.0",
  "description": "Tablero kanban personal con arquitectura hexagonal, TypeScript y persistencia en JSON",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "node --test --test-reporter=spec --experimental-test-coverage \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "desktop": "electron .",
    "desktop:build": "electron-builder",
    "desktop:build:mac": "electron-builder --mac",
    "desktop:build:win": "electron-builder --win",
    "desktop:build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "dev.kanban.hexagonal",
    "productName": "Kanban",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
